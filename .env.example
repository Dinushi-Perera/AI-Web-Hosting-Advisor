# Local Docker development values. Replace passwords/secrets before shared or production deployment.
MYSQL_DATABASE=ai_web_hosting_advisor
MYSQL_APP_USER=hosting_app
MYSQL_APP_PASSWORD=hosting_app_password
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_HOST_PORT=3307
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8001
DOCKER_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1

JWT_SECRET=dev-only-change-this-to-a-long-random-secret-123456789
SEED_ADMIN_EMAIL=admin@hostingadvisor.local
SEED_ADMIN_PASSWORD=Admin123!ChangeMe

# Configure these values to send real password-reset links.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Web Hosting Advisor
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_RETURN_TOKEN=false

PAGESPEED_API_KEY=
OPENROUTER_API_KEY=
LLM_ENABLED=false
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_RETRY_ATTEMPTS=3
OPENROUTER_APP_TITLE=AI Web Hosting Advisor
CLASSIFIER_MODEL_PATH=models/classifier/production/LogisticRegression_full5000.joblib
RESOURCE_MODEL_PATH=models/resource/production/RandomForestRegressor_full5000.joblib

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_AUTH_REQUIRED=true
# Safe, backend-enforced k6 planner limits. The application never executes k6.
K6_MAX_VUS=500
K6_MAX_DURATION_SECONDS=1800
K6_DEFAULT_P95_THRESHOLD_MS=2000
K6_DEFAULT_P99_THRESHOLD_MS=4000
K6_DEFAULT_CHECK_PASS_RATE=0.99
K6_BINARY_PATH=k6
K6_DEFAULT_ERROR_RATE_THRESHOLD=0.01
K6_MAX_REDIRECTS=5
K6_ALLOW_STRESS_TEST=true
K6_ALLOW_SPIKE_TEST=true
K6_ALLOW_SOAK_TEST=true
K6_RESULT_MAX_FILE_MB=5
MANAGED_LOAD_TEST_MAX_CONCURRENCY=10
MANAGED_LOAD_TEST_MAX_DURATION_SECONDS=120
MANAGED_LOAD_TEST_EXECUTION_TIMEOUT_SECONDS=120
K6_PLAN_GENERATION_LIMIT_PER_HOUR=20
K6_RESULT_IMPORT_LIMIT_PER_HOUR=20
