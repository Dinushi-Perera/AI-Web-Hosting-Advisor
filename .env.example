# Local Docker development values. Replace passwords/secrets before shared or production deployment.
MYSQL_DATABASE=ai_web_hosting_advisor
MYSQL_APP_USER=hosting_app
MYSQL_APP_PASSWORD=hosting_app_password
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_HOST_PORT=3307
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8001
DOCKER_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1

JWT_SECRET=dev-only-change-this-to-a-long-random-secret-123456789
SEED_ADMIN_EMAIL=admin@hostingadvisor.local
SEED_ADMIN_PASSWORD=Admin123!ChangeMe

# Configure these values to send real password-reset links.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Web Hosting Advisor
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_RETURN_TOKEN=false

PAGESPEED_API_KEY=
OPENAI_API_KEY=
LLM_ENABLED=false
CLASSIFIER_MODEL_PATH=models/classifier/production/hosting_classifier_SELECTED_full5000.joblib
RESOURCE_MODEL_PATH=models/resource/production/resource_sizer_SELECTED_full5000.joblib

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_AUTH_REQUIRED=true
