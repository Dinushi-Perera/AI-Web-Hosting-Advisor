APP_ENV=development
APP_NAME=AI Web Hosting Advisor
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://hosting_app:hosting_app_password@mysql:3306/ai_web_hosting_advisor
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=AI Web Hosting Advisor
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_RETURN_TOKEN=false
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
PAGESPEED_API_KEY=
PAGESPEED_CACHE_SECONDS=900
LLM_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_RETRY_ATTEMPTS=3
OPENROUTER_APP_TITLE=AI Web Hosting Advisor
CLASSIFIER_MODEL_PATH=models/classifier/production/LogisticRegression_full5000.joblib
RESOURCE_MODEL_PATH=models/resource/production/RandomForestRegressor_full5000.joblib
K6_MAX_VUS=500
K6_MAX_DURATION_SECONDS=1800
K6_DEFAULT_P95_THRESHOLD_MS=2000
K6_DEFAULT_P99_THRESHOLD_MS=4000
K6_DEFAULT_CHECK_PASS_RATE=0.99
K6_BINARY_PATH=k6
K6_DEFAULT_ERROR_RATE_THRESHOLD=0.01
K6_MAX_REDIRECTS=5
K6_ALLOW_STRESS_TEST=true
K6_ALLOW_SPIKE_TEST=true
K6_ALLOW_SOAK_TEST=true
K6_RESULT_MAX_FILE_MB=5
MANAGED_LOAD_TEST_MAX_CONCURRENCY=10
MANAGED_LOAD_TEST_MAX_DURATION_SECONDS=120
MANAGED_LOAD_TEST_EXECUTION_TIMEOUT_SECONDS=120
K6_PLAN_GENERATION_LIMIT_PER_HOUR=20
K6_RESULT_IMPORT_LIMIT_PER_HOUR=20
MAX_EXTERNAL_RESPONSE_BYTES=2000000
MAX_REDIRECTS=3
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=12
REPORT_STORAGE_DIR=storage/reports
LOAD_TEST_STORAGE_DIR=storage/load_tests
LOG_LEVEL=INFO
PRICING_STALE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTO_CREATE_TABLES=false
