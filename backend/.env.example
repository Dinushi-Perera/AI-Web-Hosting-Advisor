APP_ENV=development
APP_NAME=AI Web Hosting Advisor
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://hosting_app:hosting_app_password@mysql:3306/ai_web_hosting_advisor
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=AI Web Hosting Advisor
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_RETURN_TOKEN=false
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
PAGESPEED_API_KEY=
PAGESPEED_CACHE_SECONDS=900
LLM_ENABLED=false
OPENAI_API_KEY=
MAX_LOAD_TEST_VUS=500
MAX_LOAD_TEST_DURATION_SECONDS=1800
MAX_EXTERNAL_RESPONSE_BYTES=2000000
MAX_REDIRECTS=3
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=12
REPORT_STORAGE_DIR=storage/reports
LOAD_TEST_STORAGE_DIR=storage/load_tests
LOG_LEVEL=INFO
PRICING_STALE_DAYS=30
DEFAULT_CURRENCY=USD
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTO_CREATE_TABLES=false
